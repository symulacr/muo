NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DOCS_URL=http://localhost:3000/docs
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# Mezo network. 31611 = testnet (default), 31612 = mainnet.
# An unrecognised value is rejected rather than silently defaulted.
NEXT_PUBLIC_MEZO_CHAIN_ID=31611
NEXT_PUBLIC_MEZO_RPC_URL=https://rpc.test.mezo.org
NEXT_PUBLIC_MEZO_EXPLORER_URL=https://explorer.test.mezo.org

# MuoCore deployment and the MUSD token it bonds in.
# Both must be lowercase 20-byte 0x addresses; the portal refuses to transact otherwise.
NEXT_PUBLIC_MUO_CORE_CONTRACT=0x61c41cd7299fd668c3a7aae62f12c017fe654cb0
NEXT_PUBLIC_MUSD_ADDRESS=0x118917a40faf1cd7a13db0ef56c86de7973ac503
