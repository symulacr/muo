# v1 (Stacks) ingestion — still live until the portal cutover.
WEBHOOK_SECRET=your-secret-here
CHAINHOOKS_SECRET=your-chainhooks-secret-here

# Native Mezo indexer (v2). All placeholders — never put real values here.
#
# MEZO_RPC_URL and INDEXER_ADMIN_SECRET are NOT in wrangler.jsonc `vars`.
# Set them per environment:
#   wrangler secret put INDEXER_ADMIN_SECRET
#   wrangler secret put MEZO_RPC_URL
#
# Leaving MEZO_CHAIN_ID / MEZO_CORE_ADDRESS unset makes /v2/* answer
# 503 native_index_not_configured instead of a healthy-looking empty 200.
MEZO_CHAIN_ID=31611
MEZO_CORE_ADDRESS=0x61c41cd7299fd668c3a7aae62f12c017fe654cb0
MEZO_RPC_URL=https://rpc.test.mezo.org
MEZO_START_BLOCK=16380473
MEZO_CONFIRMATIONS=12
MEZO_MAX_BLOCKS_PER_RUN=500

# Bearer for POST /v2/indexer/run. Unset => the route answers 503 and can
# never be triggered anonymously.
INDEXER_ADMIN_SECRET=your-indexer-admin-secret-here
