{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "muo",
  "description": "Mezo Upbeat Oracle: a permissionless optimistic oracle on Mezo",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.3",
  "scripts": {
    "test": "node scripts/test-workspaces.mjs && node --test scripts/__tests__/stage-source.test.mjs scripts/__tests__/test-workspaces.test.mjs scripts/__tests__/verify-local.test.mjs",
    "test:artifacts": "node --test scripts/__tests__/stage-source.test.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "stage:source": "node scripts/stage-source.mjs"
  },
  "workspaces": {
    "packages": [
      "contracts/*",
      "packages/*"
    ],
    "catalog": {
      "@biomejs/biome": "2.5.15",
      "@hugeicons/core-free-icons": "4.3.5",
      "@hugeicons/react": "1.1.10",
      "@tsconfig/bun": "1.0.11",
      "@types/bun": "1.4.3",
      "@types/node": "25.3.5",
      "next": "16.4.2",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "typescript": "5.9.3",
      "zod": "4.6.7"
    }
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "typescript": "catalog:"
  },
  "overrides": {
    "@emnapi/wasi-threads": "2.2.0",
    "@jridgewell/trace-mapping": "0.3.31",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "abitype": "1.3.0",
    "ansi-styles": "7.0.0",
    "clsx": "2.1.1",
    "esbuild": "0.28.2",
    "eventemitter3": "5.0.4",
    "idb-keyval": "6.3.0",
    "node-fetch": "3.3.2",
    "ox": "0.14.56",
    "path-to-regexp": "8.4.2",
    "picomatch": "4.0.7",
    "postcss": "8.5.23",
    "semver": "7.8.5",
    "sharp": "0.35.5",
    "string-width": "8.3.0",
    "tslib": "2.8.1",
    "undici": "8.12.2",
    "undici-types": "8.12.2",
    "viem": "2.57.7",
    "vitest": "5.0.5",
    "wrap-ansi": "10.0.2",
    "ws": "8.22.0",
    "yargs": "18.2.0",
    "zod": "4.6.7"
  }
}
